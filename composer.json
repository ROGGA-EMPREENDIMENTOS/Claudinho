{
    "name": "rogga/claudinho",
    "description": "Assistente de chat em linguagem natural sobre os dados da própria aplicação Laravel, integrado à API do Claude via tool use.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "livewire/livewire": "^3.0|^4.0",
        "guzzlehttp/guzzle": "^7.0",
        "league/commonmark": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Rogga\\Claudinho\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rogga\\Claudinho\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rogga\\Claudinho\\ClaudinhoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
